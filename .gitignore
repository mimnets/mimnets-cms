.env
# Staging settings (m1-055).
/docker/staging/site.env
/locales
npm-debug.log
/data
/public/uploads
/public/apos-minified
/data/temp/uploadfs
node_modules
# This folder is created on the fly and contains symlinks updated at startup (we'll come up with a Windows solution that actually copies things)
/public/modules
# Don't commit build files
/apos-build
/public/apos-frontend
/modules/asset/ui/public/site.js
# Don't commit masters generated on the fly at startup, these import all the rest
/public/css/master-*.less
.jshintrc
.DS_Store


# Database dumps and backups contain password hashes, session and API
# tokens, and form submissions (personal data). Never commit them.
*.jsonl
*.dump
*.sql
*.sqlite
*.db
*.db-shm
*.db-wal
/backups
# Local release marker for production builds
release-id
# Per-user Claude Code settings
.claude/settings.local.json

# Local test evidence (screenshots may show test data). Never commit.
/evidence

# Local notes from the vibecode explorer plugin. Never commit.
/.vibecode
